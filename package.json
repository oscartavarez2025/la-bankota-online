{
  "name": "banca-digital-loteria-saas",
  "version": "2.0.0",
  "description": "Sistema de Banca de Lotería multi-tenant (SaaS) — PostgreSQL + RLS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "psql \"$DATABASE_URL\" -f ../db-postgres/schema.sql",
    "seed": "node seed.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/logica.test.js",
    "test:rls": "node --test tests/rls-isolation.test.js",
    "test:e2e": "node --test tests/e2e-flujo-completo.test.js",
    "check:prod": "node check-production-ready.js",
    "backup:dr": "node backup-disaster-recovery.js"
  },
  "keywords": ["loteria", "quiniela", "pale", "tripleta", "saas", "multi-tenant"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  }
}
