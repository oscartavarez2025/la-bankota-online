# Copia a ".env" y ajusta. NUNCA subas el .env real a git.

# Cadena de conexión a PostgreSQL. En producción usa el rol "app_banca"
# (ver sección 11 de schema.sql) — NUNCA el superusuario/dueño del esquema.
DATABASE_URL=postgres://app_banca:CAMBIA_ESTO@localhost:5432/labankota

JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PORT=6001
ALLOWED_ORIGINS=http://localhost:6001
NODE_ENV=development

# Credenciales del primer super_admin de plataforma, usadas SOLO por seed.js
# la primera vez (no se guardan en el código, no quedan en la base en texto plano)
SEED_SUPERADMIN_USUARIO=superadmin
SEED_SUPERADMIN_PASSWORD=cambia-esto-antes-de-correr-seed

# Para "npm run test:rls" — cadena de conexión a una base/rama de PRUEBA,
# separada de tu base de desarrollo (en Neon: crea una rama nueva, "Branches"
# → "Create branch"). El rol usado debe tener NOBYPASSRLS igual que en
# producción, o la prueba dará un falso positivo. Si no la defines, la
# prueba usará DATABASE_URL (tu base normal) con una advertencia.
TEST_DATABASE_URL=
